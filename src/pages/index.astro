---
import Base from '../layouts/Base.astro';
import {
  Cookie,
  CookingPot,
  HeartHandshake,
  MessageCircle,
  Gift,
  TreePine,
  Utensils,
  UtensilsCrossed,
} from '@lucide/astro';
import Lantern from '../components/Lantern.astro';
import Lights from '../components/Lights.astro';
import { site, event, stats, giftDropoff, giftWishes, extraFaq } from '../data/site';

const nav = [
  { href: '#om-oss', label: 'Om oss' },
  { href: '#julfirandet', label: 'Julfirandet' },
  { href: '#volontar', label: 'Volontär' },
  { href: '#stod-oss', label: 'Stöd oss' },
  { href: '#kontakt', label: 'Kontakt' },
];

const taskGroups = [
  {
    title: 'Före juldagen',
    tasks: [
      { icon: Cookie, title: 'Baka', text: 'Kakor och bullar inför firandet.' },
      { icon: TreePine, title: 'Pynta', text: 'Förbereda och göra lokalen julig.' },
    ],
  },
  {
    title: `På juldagen kl. ${event.time}`,
    tasks: [
      { icon: CookingPot, title: 'Laga mat', text: 'Laga eller värma upp jullunchen.' },
      { icon: UtensilsCrossed, title: 'Servera', text: 'Duka, servera och plocka undan.' },
      { icon: MessageCircle, title: 'Umgås', text: 'Sitta ner, prata och bjuda på sällskap.' },
    ],
  },
];

const faq = [
  {
    q: 'Behöver jag erfarenhet för att vara volontär?',
    a: 'Nej. Alla är välkomna, och vi går igenom allt på volontärträffen och på plats.',
  },
  {
    q: 'Måste jag vara med hela dagen?',
    a: 'Nej, du hjälper till med så mycket eller lite du vill – före eller under firandet.',
  },
  {
    q: 'Vart går mina pengar?',
    a: 'Allt går till firandet: mat, julklappar och det som behövs för dagen. Föreningen drivs helt ideellt av volontärer.',
  },
  {
    q: 'Jag vet någon som borde komma – hur gör jag?',
    a: `Hör av dig till oss på ${site.email} så berättar vi mer.`,
  },
  ...extraFaq.filter((f) => f.a.trim() !== ''),
];

const showStats = stats.every((s) => s.value.trim() !== '');
const newTab = 'öppnas i ny flik';
---

<Base>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="#" class="brand">
        <img src="/logo.jpg" alt="" width="40" height="40" />
        <span>Föreningen Lyktan</span>
      </a>
      <nav aria-label="Huvudmeny">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <a href="#swish" class="topbar-swish">Swisha</a>
      <a href={site.volunteerForm} class="btn btn-amber topbar-cta" target="_blank" rel="noopener">
        Bli volontär<span class="sr-only"> ({newTab})</span>
      </a>
    </div>
  </header>

  <main id="innehall">
    <section class="hero">
      <Lights />
      <div class="wrap hero-inner">
        <div class="hero-text">
          <p class="season-note" data-after={event.endIso} hidden>
            Tack för i år! Julfirandet {event.year} är över – vi ses nästa jul.
          </p>
          <h1>Ingen ska behöva fira jul ensam.</h1>
          <p class="hero-lead">
            Föreningen Lyktan ordnar julfirande för ensamma äldre och äldre hemlösa – med mat, musik,
            gemenskap och omtanke.
          </p>
          <div class="hero-actions">
            <a href={site.volunteerForm} class="btn btn-amber" target="_blank" rel="noopener">
              Bli volontär<span class="sr-only"> ({newTab})</span>
            </a>
            <a href="#swish" class="btn btn-white">
              Bidra med <img src="/swish.svg" alt="Swish" width="72" height="22" />
            </a>
          </div>
        </div>
        <div class="hero-logo" aria-hidden="true">
          <div class="glow"></div>
          <img src="/logo.jpg" alt="" width="150" height="150" />
        </div>
      </div>
    </section>

    <section id="om-oss" class="section">
      <div class="wrap about">
        <div>
          <h2>Ett ljus i mörkret</h2>
          <p class="lead">
            Julen ska vara en tid av gemenskap – men för många äldre, både på boenden och utan eget hem,
            är den årets ensammaste tid. Det vill vi ändra på.
          </p>
          <p>
            Föreningen Lyktan är en ideell förening som drivs helt av volontärer. Varje juldag öppnar
            vi dörrarna till en jullunch där ingen behöver vara ensam: ett dukat bord, god mat, musik
            och människor som vill umgås. Varje krona och varje timme som skänks går direkt till
            firandet och till våra gäster.
          </p>
          <a href={site.instagram.url} class="btn btn-ghost instagram-btn" target="_blank" rel="noopener">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
            </svg>
            Följ {site.instagram.handle}<span class="sr-only"> på Instagram ({newTab})</span>
          </a>
        </div>
        <ul class="pillars">
          <li>
            <span class="icon"><Utensils aria-hidden="true" /></span>
            <div><h3>Jullunch</h3><p>Lagad och serverad av volontärer, med hembakat fika.</p></div>
          </li>
          <li>
            <span class="icon"><Gift aria-hidden="true" /></span>
            <div><h3>Julklappar</h3><p>En julklapp till gästerna från vår insamling.</p></div>
          </li>
          <li>
            <span class="icon"><HeartHandshake aria-hidden="true" /></span>
            <div><h3>Sällskap</h3><p>Ett dukat bord och någon som har tid att lyssna.</p></div>
          </li>
        </ul>
      </div>

      {
        showStats && (
          <div class="wrap">
            <ul class="stats">
              {stats.map((s) => (
                <li>
                  <strong>{s.value}</strong>
                  <span>{s.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    <section id="julfirandet" class="section event">
      <Lantern class="deco-lantern event-lantern" />
      <div class="wrap event-inner">
        <div>
          <h2>Juldagen {event.year}</h2>
          <p class="lead">
            Dagen du hjälper till med: en eftermiddag med jullunch, fika, musik och julklappar för
            våra gäster.
          </p>
        </div>
        <dl class="event-card">
          <div><dt>När</dt><dd>{event.dateLong}<br />kl. {event.time}</dd></div>
          <div>
            <dt>Var</dt>
            <dd>
              {event.address}<br />{event.area}<br />
              <a href={event.mapUrl} class="map-link" target="_blank" rel="noopener">
                Visa på karta<span class="sr-only"> ({newTab})</span> →
              </a>
            </dd>
          </div>
          <div><dt>Gäster</dt><dd>Ensamma äldre och äldre hemlösa – gratis för alla gäster</dd></div>
          {
            event.volunteerArrival && (
              <div>
                <dt>Volontärer</dt>
                <dd>På plats {event.volunteerArrival}</dd>
              </div>
            )
          }
          {
            event.signupDeadline && (
              <div>
                <dt>Anmälan</dt>
                <dd>Senast {event.signupDeadline}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </section>

    <section id="volontar" class="section">
      <div class="wrap">
        <h2>Ge en timme – ge någon en jul</h2>
        <p class="lead">
          Vi behöver hjälp både inför firandet och på juldagen kl. {event.time}. Du behöver ingen
          tidigare erfarenhet – bara lust att bidra.
        </p>

        <div class="task-groups">
          {
            taskGroups.map((group) => (
              <div class="task-group">
                <h3>{group.title}</h3>
                <ul class="tasks">
                  {group.tasks.map((t) => (
                    <li>
                      <span class="icon">
                        <t.icon aria-hidden="true" />
                      </span>
                      <div>
                        <strong>{t.title}</strong>
                        <p>{t.text}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <ol class="steps">
          <li>
            <h3>Anmäl intresse</h3>
            <p>Fyll i vårt formulär – det tar bara ett par minuter.</p>
          </li>
          <li>
            <h3>Kom på volontärträffen</h3>
            <p>
              En digital träff där du lär känna föreningen och de andra volontärerna och får svar på
              dina frågor. Datum väljer du i formuläret.
            </p>
          </li>
          <li>
            <h3>Var med på juldagen</h3>
            <p>Eller hjälp till med förberedelserna – du väljer själv hur mycket.</p>
          </li>
        </ol>

        <div class="volunteer-cta">
          <a href={site.volunteerForm} class="btn btn-primary" target="_blank" rel="noopener">
            Bli volontär<span class="sr-only"> ({newTab})</span>
          </a>
          <p>
            Anmälan görs i ett Google-formulär som öppnas i en ny flik.
            {event.signupDeadline && <> Sista dag: {event.signupDeadline}.</>}
          </p>
        </div>
      </div>
    </section>

    <section id="stod-oss" class="section support">
      <div class="wrap">
        <h2>Stöd julfirandet</h2>
        <p class="lead">
          Med ett bidrag eller en julklapp gör du juldagen varmare för någon som annars hade varit
          ensam.
        </p>

        <div class="support-grid">
          <article class="card card-swish" id="swish">
            <h3>Swisha ett bidrag</h3>
            <p>
              Föreningen drivs helt ideellt – allt går till mat, julklappar och det som behövs för
              juldagen.
            </p>
            <div class="swish">
              <img src="/swish.svg" alt="Swish" class="swish-logo" width="92" height="28" />
              <span class="swish-number">{site.swish}</span>
              <button type="button" class="copy" data-copy={site.swish.replace(/\s/g, '')}>
                Kopiera
              </button>
            </div>
            <p class="copy-status" role="status" aria-live="polite"></p>
            <p class="swish-hint">
              {site.swishRecipient && <>Mottagare i Swish: <strong>{site.swishRecipient}</strong>. </>}
              Märk gärna betalningen ”{site.swishMessage}”.
            </p>
            <figure class="swish-qr">
              <img
                src="/swish-qr.png"
                alt={`QR-kod för Swish till ${site.swish}`}
                width="360"
                height="360"
                loading="lazy"
              />
              <figcaption>Skanna med Swish-appen</figcaption>
            </figure>
          </article>

          <article class="card">
            <h3>Julklappsinsamling</h3>
            <p>
              Förra årets insamling blev en stor succé – i år hoppas vi kunna ge minst lika många
              gäster en julklapp. Önskas till exempel:
            </p>
            <ul class="checklist">
              {giftWishes.map((g) => <li>{g}</li>)}
            </ul>
            <p class="small">
              {
                giftDropoff || (
                  <>
                    Var och när du lämnar julklappar meddelar vi snart här och på{' '}
                    <a href={site.instagram.url} target="_blank" rel="noopener">
                      Instagram<span class="sr-only"> ({newTab})</span>
                    </a>
                    .
                  </>
                )
              }
            </p>
          </article>

        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap faq">
        <div>
          <h2>Bra att veta</h2>
          <p class="faq-aside">
            Hittar du inte svaret? Mejla <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </div>
        <div>
          {
            faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="kontakt" class="section contact">
      <Lantern class="deco-lantern contact-lantern-left" />
      <Lantern class="deco-lantern contact-lantern-right" />
      <div class="wrap contact-inner">
        <h2>Var med och gör juldagen varm</h2>
        <p class="lead">Som volontär, med ett bidrag eller genom att dela vidare till någon som vill hjälpa till.</p>
        <div class="contact-actions">
          <a href={site.volunteerForm} class="btn btn-amber" target="_blank" rel="noopener">
            Bli volontär<span class="sr-only"> ({newTab})</span>
          </a>
          <a href="#swish" class="btn btn-white">
            Bidra med <img src="/swish.svg" alt="Swish" width="72" height="22" />
          </a>
        </div>
        <p class="contact-more">
          Frågor eller idéer? Mejla <a href={`mailto:${site.email}`}>{site.email}</a> eller följ och
          dela <a href={site.instagram.url} target="_blank" rel="noopener"
            >{site.instagram.handle}<span class="sr-only"> på Instagram ({newTab})</span></a
          >.
        </p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <p><strong>Föreningen Lyktan</strong> · Ideell förening · Stockholm</p>
      {site.orgNr && <p>Org.nr {site.orgNr}</p>}
    </div>
  </footer>
</Base>

<script>
  // navigator.clipboard finns bara över HTTPS och kan nekas, så vi faller tillbaka på execCommand.
  async function copy(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return;
      } catch {
        // prova reservsättet nedan
      }
    }
    const el = document.createElement('textarea');
    el.value = text;
    el.setAttribute('readonly', '');
    el.style.position = 'fixed';
    el.style.opacity = '0';
    document.body.append(el);
    el.select();
    const ok = document.execCommand('copy');
    el.remove();
    if (!ok) throw new Error('copy failed');
  }

  // Efter juldagen: visa tack-raden i stället för att låtsas att firandet är kommande
  document.querySelectorAll<HTMLElement>('[data-after]').forEach((el) => {
    if (Date.now() > Date.parse(el.dataset.after ?? '')) el.hidden = false;
  });

  const status = document.querySelector<HTMLElement>('.copy-status');

  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await copy(btn.dataset.copy ?? '');
        btn.textContent = 'Kopierat!';
        if (status) status.textContent = 'Swish-numret är kopierat.';
      } catch {
        btn.textContent = 'Kopiera';
        if (status) status.textContent = 'Kunde inte kopiera. Markera numret och kopiera det själv.';
        return;
      }
      setTimeout(() => {
        btn.textContent = 'Kopiera';
        if (status) status.textContent = '';
      }, 2500);
    });
  });
</script>

<style>
  .icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: var(--gold-soft);
    color: var(--gold);
  }

  .icon :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }

  /* Dekor */
  .hero,
  .event,
  .support,
  .contact {
    position: relative;
    overflow: hidden;
  }

  .hero > .wrap,
  .event > .wrap,
  .support > .wrap,
  .contact > .wrap {
    position: relative;
  }


  :global(.deco-lantern) {
    position: absolute;
    color: var(--gold);
    opacity: 0.07;
    pointer-events: none;
  }

  :global(.event-lantern) {
    height: 30rem;
    left: -7rem;
    bottom: -6rem;
    rotate: -8deg;
  }

  :global(.contact-lantern-left) {
    height: 18rem;
    left: 6%;
    top: -2rem;
    rotate: 6deg;
  }

  :global(.contact-lantern-right) {
    height: 13rem;
    right: 8%;
    bottom: -3rem;
    rotate: -10deg;
  }

  @media (max-width: 760px) {
    :global(.event-lantern) {
      height: 20rem;
      left: auto;
      right: -3rem;
      bottom: auto;
      top: 1rem;
    }

    :global(.contact-lantern-left) {
      left: -2rem;
    }
  }

  /* Topbar */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(26 15 18 / 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.125rem;
    white-space: nowrap;
    text-decoration: none;
  }

  .brand img {
    border-radius: 50%;
  }

  @media (max-width: 420px) {
    .brand {
      font-size: 0.9375rem;
      gap: 0.5rem;
    }

    .brand img {
      width: 32px;
      height: 32px;
    }
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  nav a:hover {
    opacity: 1;
    color: var(--gold);
  }

  .topbar-swish {
    display: none;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    margin-left: auto;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
  }

  .topbar-swish:hover {
    color: var(--gold);
  }

  .topbar-cta {
    position: relative;
    white-space: nowrap;
    padding: 0.5rem 1.1rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }

    .topbar-swish {
      display: inline-flex;
    }
  }

  @media (max-width: 420px) {
    .topbar-cta {
      padding: 0.35rem 0.8rem;
      font-size: 0.8125rem;
      line-height: 1.2;
    }

    .topbar-inner {
      gap: 0.75rem;
    }

    /* Liten knapp, men 44px träffyta */
    .topbar-cta::after {
      content: '';
      position: absolute;
      inset: -7px -4px;
    }
  }

  /* Smala telefoner: loggan syns ändå stort i toppsektionen */
  @media (max-width: 400px) {
    .brand img {
      display: none;
    }
  }

  @media (max-width: 340px) {
    .topbar-swish {
      display: none;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 75% 45%, rgb(227 180 91 / 0.18), transparent 45%),
      radial-gradient(circle at 0% 100%, rgb(107 34 48 / 0.4), transparent 50%),
      radial-gradient(1px 1px at 10% 20%, #fff8 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 30% 70%, #fff6 50%, transparent 51%),
      radial-gradient(1px 1px at 55% 15%, #fff8 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 85% 80%, #fff6 50%, transparent 51%),
      radial-gradient(1px 1px at 92% 25%, #fff8 50%, transparent 51%),
      linear-gradient(180deg, var(--bg-deep) 0%, var(--bg) 100%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(5.5rem, 11vw, 8rem) clamp(4rem, 10vw, 7rem);
  }


  .hero-lead {
    font-size: 1.25rem;
    opacity: 0.85;
    max-width: 34rem;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-white {
    background: var(--text);
    color: var(--on-gold);
  }

  .btn-white img {
    height: 1.35rem;
    width: auto;
  }

  .hero-logo {
    position: relative;
    justify-self: center;
    display: grid;
    place-items: center;
  }

  .hero-logo .glow {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(227 180 91 / 0.3), transparent 65%);
  }

  .hero-logo img {
    position: relative;
    width: clamp(11rem, 22vw, 16rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 6px solid var(--text);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.35);
  }

  @media (max-width: 760px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-logo {
      order: -1;
    }

    .hero-logo img {
      width: 9rem;
    }
  }

  /* About */
  .instagram-btn {
    margin-top: 0.5rem;
  }

  .about {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .pillars li {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .pillars .icon {
    flex-shrink: 0;
  }

  .pillars h3 {
    margin-bottom: 0.25rem;
  }

  .pillars p {
    margin: 0;
    color: var(--muted);
  }

  .stats {
    list-style: none;
    padding: 0;
    margin: 3.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 2.5rem;
  }

  .stats li {
    text-align: center;
  }

  .stats strong {
    display: inline-block;
    font-family: var(--serif);
